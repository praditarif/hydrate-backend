// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
//   Skema Database Hydrate (diterjemahkan dari ERD)
// =============================================

model Pengguna {
  // PK adalah UID dari Firebase (text), sesuai spesifikasi proposal.
  id                   String                 @id @map("id")
  email                String                 @unique @db.VarChar(255)
  berat_badan_kg       Decimal?               @db.Decimal(5, 2)
  tanggal_lahir        DateTime?              @db.Date
  data_profil_tambahan Json?
  waktu_dibuat         DateTime               @default(now())
  waktu_diperbarui     DateTime?              @updatedAt
  waktu_dihapus        DateTime? // Untuk soft delete

  // Relasi (satu pengguna bisa memiliki banyak...)
  perangkat          PerangkatPengguna[]
  log_konsumsi       LogKonsumsi[]
  log_aktivitas_ringan LogAktivitasRingan[]
  sesi_aktivitas_berat SesiAktivitasBerat[]
  ringkasan_harian   RingkasanHarian[]
  ringkasan_bulanan  RingkasanBulanan[]

  @@map("pengguna")
}

model PerangkatPengguna {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid()) @db.Uuid
  id_pengguna          String
  nama_perangkat       String?   @db.VarChar(100)
  token_fcm            String    @unique
  waktu_login_terakhir DateTime?
  waktu_dibuat         DateTime  @default(now())

  // Definisi relasi
  pengguna Pengguna @relation(fields: [id_pengguna], references: [id], onDelete: Cascade)

  @@map("perangkat_pengguna")
}

model LogKonsumsi {
  id               Int      @id @default(autoincrement())
  uuid             String   @unique @default(uuid()) @db.Uuid
  id_pengguna      String
  waktu_pencatatan DateTime @default(now())
  jumlah_ml        Decimal  @db.Decimal(10, 2)

  // Definisi relasi
  pengguna Pengguna @relation(fields: [id_pengguna], references: [id], onDelete: Cascade)

  @@map("log_konsumsi")
}

model LogAktivitasRingan {
  id                    Int      @id @default(autoincrement())
  uuid                  String   @unique @default(uuid()) @db.Uuid
  id_pengguna           String
  waktu_mulai           DateTime
  jumlah_langkah        Int
  koefisien_lingkungan  Decimal  @db.Decimal(3, 2)
  tambahan_hidrasi_ml   Decimal  @db.Decimal(10, 2)
  waktu_dibuat          DateTime @default(now())

  // Definisi relasi
  pengguna Pengguna @relation(fields: [id_pengguna], references: [id], onDelete: Cascade)

  @@map("log_aktivitas_ringan")
}

model RefJenisAktivitas {
  id                  Int      @id @default(autoincrement())
  nama_aktivitas      String   @unique @db.VarChar(100)
  koefisien_intensitas Decimal  @db.Decimal(4, 2)

  // Relasi (satu jenis aktivitas bisa ada di banyak sesi)
  sesi_aktivitas_berat SesiAktivitasBerat[]

  @@map("ref_jenis_aktivitas")
}

model SesiAktivitasBerat {
  id                   Int       @id @default(autoincrement())
  uuid                 String    @unique @default(uuid()) @db.Uuid
  id_pengguna          String
  id_jenis_aktivitas   Int
  waktu_mulai          DateTime
  durasi_menit         Int
  koefisien_intensitas   Decimal   @db.Decimal(4, 2)
  koefisien_lingkungan   Decimal   @db.Decimal(3, 2)
  tambahan_hidrasi_ml  Decimal   @db.Decimal(10, 2)
  waktu_dibuat         DateTime  @default(now())
  waktu_diperbarui     DateTime? @updatedAt
  waktu_dihapus        DateTime? // Untuk soft delete

  // Definisi relasi
  pengguna       Pengguna         @relation(fields: [id_pengguna], references: [id], onDelete: Cascade)
  jenis_aktivitas RefJenisAktivitas @relation(fields: [id_jenis_aktivitas], references: [id], onDelete: Restrict)

  @@map("sesi_aktivitas_berat")
}

model RingkasanHarian {
  id                       Int     @id @default(autoincrement())
  uuid                     String  @unique @default(uuid()) @db.Uuid
  id_pengguna              String
  tanggal                  DateTime @db.Date
  hidrasi_basal_ml         Decimal? @db.Decimal(10, 2)
  total_tambahan_ringan_ml Decimal? @db.Decimal(10, 2)
  total_tambahan_berat_ml  Decimal? @db.Decimal(10, 2)
  target_total_ml          Decimal? @db.Decimal(10, 2)
  konsumsi_total_ml        Decimal? @db.Decimal(10, 2)

  // Definisi relasi
  pengguna Pengguna @relation(fields: [id_pengguna], references: [id], onDelete: Cascade)

  // Definisi index unik
  @@unique([id_pengguna, tanggal])
  @@map("ringkasan_harian")
}

model RingkasanBulanan {
  id                          Int      @id @default(autoincrement())
  uuid                        String   @unique @default(uuid()) @db.Uuid
  id_pengguna                 String
  bulan_mulai                 DateTime @db.Date
  rata_rata_target_harian_ml  Decimal? @db.Decimal(10, 2)
  rata_rata_konsumsi_harian_ml Decimal? @db.Decimal(10, 2)
  tingkat_kepatuhan_persen    Decimal? @db.Decimal(5, 2)

  // Definisi relasi
  pengguna Pengguna @relation(fields: [id_pengguna], references: [id], onDelete: Cascade)

  // Definisi index unik
  @@unique([id_pengguna, bulan_mulai])
  @@map("ringkasan_bulanan")
}